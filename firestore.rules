rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        request.auth.token.admin == true;
    }
    
    function isMeetingParticipant(meetingId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/meetings/$(meetingId)) &&
        (get(/databases/$(database)/documents/meetings/$(meetingId)).data.hostId == request.auth.uid ||
         request.auth.uid in get(/databases/$(database)/documents/meetings/$(meetingId)).data.participantIds);
    }
    
    function isMeetingHost(meetingId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/meetings/$(meetingId)) &&
        get(/databases/$(database)/documents/meetings/$(meetingId)).data.hostId == request.auth.uid;
    }
    
    // HYBRID MODE: Support both anonymous and authenticated users during migration
    function isAuthenticatedOrAnonymous() {
      return request.auth != null;  // Includes anonymous auth
    }
    
    // Users collection - HYBRID MODE
    match /users/{userId} {
      // Allow users to read/write their own profile (including anonymous)
      allow read, write: if isAuthenticatedOrAnonymous() && request.auth.uid == userId;
      
      // User voice profiles (subcollection)
      match /voiceProfiles/{profileId} {
        allow read, write: if isAuthenticatedOrAnonymous() && request.auth.uid == userId;
      }
    }
    
    // User preferences - HYBRID MODE
    match /userPreferences/{userId} {
      allow read, write: if isAuthenticatedOrAnonymous() && request.auth.uid == userId;
    }
    
    // Voice Library collection - HYBRID MODE with improved security
    match /voice_library/{deepgramVoiceId} {
      // Allow reading if:
      // 1. User owns it (userId field matches)
      // 2. It's confirmed (public)
      // 3. User is authenticated (for identification)
      allow read: if isAuthenticatedOrAnonymous() && (
        (resource.data.userId == request.auth.uid) ||
        (resource.data.confirmed == true) ||
        isAdmin()
      );
      
      allow create: if isAuthenticatedOrAnonymous() &&
        (!('userId' in request.resource.data) || 
         request.resource.data.userId == request.auth.uid);
      
      allow update: if isAuthenticatedOrAnonymous() && (
        (resource.data.userId == request.auth.uid) ||
        (resource.data.confirmed == false && 
         request.resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      
      allow delete: if isAuthenticatedOrAnonymous() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Meetings collection - PRESERVE COLLABORATION
    match /meetings/{meetingId} {
      // Allow read for hosts and participants
      allow read: if isAuthenticatedOrAnonymous() && (
        resource.data.hostId == request.auth.uid ||
        ('participantIds' in resource.data && 
         request.auth.uid in resource.data.participantIds) ||
        isAdmin()
      );
      
      // Anyone authenticated can create meetings
      allow create: if isAuthenticatedOrAnonymous() &&
        request.resource.data.hostId == request.auth.uid;
      
      // Hosts and participants can update (with restrictions)
      allow update: if isAuthenticatedOrAnonymous() && (
        resource.data.hostId == request.auth.uid ||
        ('participantIds' in resource.data &&
         request.auth.uid in resource.data.participantIds &&
         // Participants can only update specific fields
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['transcript', 'participants', 'currentModel', 'modelContext', 'status']))
      );
      
      allow delete: if isAuthenticatedOrAnonymous() && 
        resource.data.hostId == request.auth.uid;
        
      // Meeting subcollections - accessible to participants
      match /notes/{noteId} {
        allow read, write: if isMeetingParticipant(meetingId);
      }
      
      match /transcripts/{transcriptId} {
        allow read, write: if isMeetingParticipant(meetingId);
        
        match /entries/{entryId} {
          allow read, write: if isMeetingParticipant(meetingId);
        }
      }
      
      match /speakers/{speakerId} {
        allow read, write: if isMeetingParticipant(meetingId);
      }
      
      match /analytics/{analyticsId} {
        allow read: if isMeetingParticipant(meetingId);
        allow write: if isMeetingHost(meetingId);
      }
    }
    
    // Meeting Types collection - HYBRID MODE
    match /meetingTypes/{typeId} {
      allow read: if isAuthenticatedOrAnonymous() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.regularParticipants != null &&
         request.auth.uid in resource.data.regularParticipants) ||
        isAdmin()
      );
      
      allow create: if isAuthenticatedOrAnonymous() &&
        request.resource.data.ownerId == request.auth.uid;
      
      allow update: if isAuthenticatedOrAnonymous() &&
        resource.data.ownerId == request.auth.uid;
      
      allow delete: if isAuthenticatedOrAnonymous() &&
        resource.data.ownerId == request.auth.uid;
    }
    
    // Needs Identification collection
    match /needs_identification/{requestId} {
      allow read: if isAuthenticatedOrAnonymous() && (
        resource.data.hostId == request.auth.uid ||
        isMeetingParticipant(resource.data.meetingId) ||
        isAdmin()
      );
      
      allow create: if isAuthenticatedOrAnonymous() &&
        request.resource.data.hostId == request.auth.uid;
      
      allow update: if isAuthenticatedOrAnonymous() && (
        resource.data.hostId == request.auth.uid ||
        isMeetingHost(resource.data.meetingId)
      );
      
      allow delete: if isAuthenticatedOrAnonymous() &&
        (resource.data.hostId == request.auth.uid || isAdmin());
    }
    
    // Voice Matches collection
    match /voice_matches/{deepgramVoiceId} {
      allow read: if isAuthenticatedOrAnonymous() && (
        ('confirmedUserId' in resource.data && 
         resource.data.confirmedUserId == request.auth.uid) || 
        isAdmin()
      );
      
      allow write: if isAdmin();
    }
    
    // Audio clips collection - HYBRID MODE
    match /audioClips/{clipId} {
      // Temporary: Allow authenticated users to access clips
      allow read: if isAuthenticatedOrAnonymous();
      allow write: if isAuthenticatedOrAnonymous();
    }
    
    // Custom rules collection
    match /customRules/{ruleId} {
      allow read: if isAuthenticatedOrAnonymous() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.isPublic == true)
      );
      
      allow create: if isAuthenticatedOrAnonymous() &&
        request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuthenticatedOrAnonymous() &&
        resource.data.userId == request.auth.uid;
      
      allow delete: if isAuthenticatedOrAnonymous() &&
        resource.data.userId == request.auth.uid;
    }
    
    // TTS cache collection - HYBRID MODE
    match /ttsCache/{cacheId} {
      // Temporary: Allow all authenticated users during migration
      allow read, write, delete: if isAuthenticatedOrAnonymous();
    }
    
    // Cost tracking collections
    match /costs/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      match /apiCalls/{callId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /budgets/{budgetId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /analytics/{period} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // Test collection for development
    match /test-collection/{docId} {
      // Allow authenticated users to test
      allow read: if isAuthenticatedOrAnonymous() && (
        !('userId' in resource.data) ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticatedOrAnonymous();
      allow update: if isAuthenticatedOrAnonymous() && (
        !('userId' in resource.data) ||
        resource.data.userId == request.auth.uid
      );
      allow delete: if isAuthenticatedOrAnonymous() && (
        !('userId' in resource.data) ||
        resource.data.userId == request.auth.uid
      );
    }
    
    // System configuration
    match /systemConfig/{configId} {
      allow read: if isAuthenticatedOrAnonymous();
      allow write: if isAdmin();
    }
    
    // Feature flags collection - public read for all users
    match /systemConfig/featureFlags {
      allow read: if true;  // Public read for feature flags
      allow write: if isAdmin();
    }
    
    // User feature overrides
    match /userFeatureOverrides/{userId} {
      allow read, write: if isAuthenticatedOrAnonymous() && request.auth.uid == userId;
    }
    
    // Migration logs
    match /migrationLogs/{document=**} {
      allow write: if isAuthenticatedOrAnonymous();
      allow read: if isAuthenticatedOrAnonymous() && (isAdmin() || request.auth.uid == resource.data.userId);
    }
    
    // Agent configurations
    match /agents/{agentId} {
      allow read: if isAuthenticatedOrAnonymous();
      allow write: if isAdmin();
    }
  }
}