rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        request.auth.token.admin == true;
    }
    
    // HYBRID MODE: Support both old and new path structures
    
    // Voice samples - LEGACY PATH (existing data)
    match /voice-samples/{deepgramVoiceId}/{fileName} {
      // Allow authenticated users to access during migration
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
        request.resource.size < 25 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');
    }
    
    // Voice samples - NEW PATH (user-isolated)
    match /voice-samples/{userId}/{deepgramVoiceId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && 
        request.resource.size < 25 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    // Meeting recordings - LEGACY PATH
    match /meeting-recordings/{meetingId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
        request.resource.size < 500 * 1024 * 1024 &&
        (request.resource.contentType.matches('audio/.*') || 
         request.resource.contentType == 'application/json');
    }
    
    // Meeting recordings - NEW PATH
    match /meeting-recordings/{userId}/{meetingId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && 
        request.resource.size < 500 * 1024 * 1024 &&
        (request.resource.contentType.matches('audio/.*') || 
         request.resource.contentType == 'application/json');
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    // Meeting clips - LEGACY PATH
    match /meeting-clips/{meetingId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
        request.resource.size < 50 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');
    }
    
    // Meeting clips - NEW PATH
    match /meeting-clips/{userId}/{meetingId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && 
        request.resource.size < 50 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    // Identification samples - LEGACY PATH
    match /identification-samples/{meetingId}/{deepgramVoiceId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
        request.resource.size < 25 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');
    }
    
    // Identification samples - NEW PATH
    match /identification-samples/{userId}/{meetingId}/{deepgramVoiceId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && 
        request.resource.size < 25 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    // User uploads - Already user-isolated
    match /user-uploads/{userId}/voice-training/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && 
        request.resource.size < 25 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    // TTS cache - LEGACY PATH
    match /tts-cache/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
        request.resource.size < 10 * 1024 * 1024;
      allow delete: if isAuthenticated();
    }
    
    // TTS cache - NEW PATH
    match /tts-cache/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && 
        request.resource.size < 10 * 1024 * 1024;
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    // Temp files - LEGACY PATH
    match /temp/{sessionId}/{fileName} {
      allow read, write: if isAuthenticated() && 
        request.resource.size < 100 * 1024 * 1024;
      allow delete: if isAuthenticated();
    }
    
    // Temp files - NEW PATH
    match /temp/{userId}/{sessionId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && 
        request.resource.size < 100 * 1024 * 1024;
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    // Exports - Already user-isolated
    match /exports/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && 
        request.resource.size < 1024 * 1024 * 1024;
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    // Profile images
    match /profile-images/{userId}/{fileName} {
      allow read: if isAuthenticated(); // Public profiles
      allow write: if isOwner(userId) && 
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    // Audio clips - LEGACY (compatibility)
    match /audio-clips/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
        request.resource.size < 25 * 1024 * 1024;
    }
    
    // System folder - Admin only
    match /system/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}